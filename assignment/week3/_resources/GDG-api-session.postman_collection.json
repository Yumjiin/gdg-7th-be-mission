    {
      "name": "1. 소비자 API",
      "item": [
        {
          "name": "1-1. 전체 상품 목록 조회",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "1-2. 상품명 단건 검색",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?itemName=원피스",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "itemName",
                  "value": "원피스"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "1-3. 장바구니 상품 일괄 구매",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/products/purchase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "purchase"
              ]
            },
            "description": "id는 실제 등록된 상품 id에 맞춰야 한다. 1-1 전체 조회 결과에서 확인.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": 1,\n    \"count\": 2\n  },\n  {\n    \"id\": 2,\n    \"count\": 1\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
